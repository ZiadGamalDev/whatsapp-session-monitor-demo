{
  "name": "whatsapp-session-monitor-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor for a simulated fleet of WhatsApp-like sessions: silent drops, false 'connected' states and messages that never arrive.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server/src/index.js",
    "demo": "npm run build && npm start",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "npm run build && tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44"
  }
}
