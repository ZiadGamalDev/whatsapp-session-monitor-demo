# Copy to .env (optional). Every value has a safe default.
PORT=3000
# 127.0.0.1 keeps the demo local. Use 0.0.0.0 only with a non-default DEMO_TOKEN.
HOST=127.0.0.1
# Single static token for the demo API and dashboard. Change it if you expose the app.
DEMO_TOKEN=demo-token
# Simulated fleet
SEED=42
SESSION_COUNT=40
SYNTHETIC_TRAFFIC=true
TRAFFIC_INTERVAL_MS=1500
ACK_TIMEOUT_MS=60000
# History store (node:sqlite). Cleared on every start because the fleet restarts from its seed.
DB_PATH=data/monitor.sqlite
# Optional Redis state store. Leave empty for in-memory.
REDIS_URL=
# Virtual clock: fast-forward N ms of simulated time, then freeze (used by screenshots).
VIRTUAL_TIME_MS=
# Alerts on state change. Without ALERT_WEBHOOK_URL, the built-in signed receiver
# (/demo/alert-sink) is used when DEMO_ALERT_SINK=true.
ALERT_WEBHOOK_URL=
# Required (long, random) when ALERT_WEBHOOK_URL is set; the app refuses the built-in default.
ALERT_WEBHOOK_SECRET=
# Operator-only. Private, loopback, link-local and metadata addresses are refused unless this is true.
ALERT_WEBHOOK_ALLOW_PRIVATE=false
DEMO_ALERT_SINK=true
# Telegram notifier stub: formats and logs only. No token, no network call.
TELEGRAM_NOTIFIER_ENABLED=false
# Optional: WhatsApp Cloud API status webhook (POST /webhooks/cloud-api).
# Disabled (503) until an app secret is set. Verify token is for the GET handshake.
CLOUD_API_APP_SECRET=
CLOUD_API_VERIFY_TOKEN=
# Abuse limits (per client IP, per minute) and max concurrent SSE streams.
RATE_LIMIT_MESSAGES_PER_MIN=30
RATE_LIMIT_RELINKS_PER_MIN=10
MAX_STREAMS=50
# Simulated WhatsApp Cloud API number (inbox, templates, signed status webhooks). Nothing talks to Meta.
CLOUD_SIM=true
# Stop free-form text outside the 24 h customer service window before sending (Meta would accept it and fail it with 131047).
CLOUD_ENFORCE_WINDOW=true
CLOUD_INBOUND_INTERVAL_MS=90000
# Webhook events older than this are ignored (replay protection).
CLOUD_MAX_EVENT_AGE_MS=604800000
